# gocryptfs-web 用户级 systemd 单元
#
# 安装（用户级，不需要 root）：
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/gocryptfs-web.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now gocryptfs-web
#   systemctl --user status gocryptfs-web
#
# 首次启动会生成 token 并打印到 journal：
#   journalctl --user -u gocryptfs-web -n 20
#
# 默认只监听 127.0.0.1:30032；远程访问请用反向代理（TLS 由代理终结），
# 例如 caddy: `reverse_proxy 127.0.0.1:30032`（对外 44332 → 本机 30032）。

[Unit]
Description=gocryptfs-web — browser UI for gocryptfs vaults
Documentation=https://github.com/lockejet/gocryptfs-ui
After=network.target

[Service]
Type=simple
# 必须以「拥有这些加密卷的普通用户」运行（不要用 root）
ExecStart=%h/.local/bin/gocryptfs-web --listen 127.0.0.1:30032
Restart=on-failure
RestartSec=2

# 重要：gocryptfs 的挂载/卸载必须在 **host mount namespace** 中完成。
# 因此本单元刻意不使用会创建私有 mount namespace 的选项：
#   PrivateTmp / ProtectSystem / ProtectHome / ProtectKernelTunables / ProtectControlGroups
#   （这些选项会让服务看到一份挂载副本，且它自己挂载的卷在主机上不可见）
# 也不能开 NoNewPrivileges / RestrictSUIDSGID：会禁用 fusermount 的 setuid。
# 安全性由「只监听 127.0.0.1 + token/TLS 反向代理 + 普通用户运行」保证。
NoNewPrivileges=no
PrivateTmp=no
ProtectSystem=no
ProtectHome=no

[Install]
WantedBy=default.target

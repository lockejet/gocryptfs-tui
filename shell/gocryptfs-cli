#!/bin/bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
LIB_DIR="$SCRIPT_DIR/lib"

# 加载 lib（单文件）
if [ -f "$LIB_DIR/gocryptfs-lib.sh" ]; then
    source "$LIB_DIR/gocryptfs-lib.sh"
else
    source "$LIB_DIR/common.sh"
fi

CONFIG_FILE="${CONFIG_FILE:-$HOME/.config/gocryptfs-tui/config.yaml}"
JSON_MODE=false
VERBOSE=false
DRY_RUN=false

# 语言：先按环境/默认配置解析，再预扫描 --lang（位置无关，便于报错也用选定语言）
i18n_init
_j=1
while [ $_j -le $# ]; do
    _a="${!_j}"
    case "$_a" in
        -l|--lang)
            _j=$((_j+1))
            [ $_j -le $# ] && { i18n_set_lang "${!_j}" || true; }
            ;;
        --lang=*) i18n_set_lang "${_a#--lang=}" || true ;;
    esac
    _j=$((_j+1))
done

# ============================================================
# 单遍扫描所有参数，识别全局选项（位置无关）
# ============================================================
POSITIONAL=()
i=1
while [ $i -le $# ]; do
    arg="${!i}"
    case "$arg" in
        -c|--config)
            i=$((i+1))
            if [ $i -gt $# ]; then
                te cli.error.config_needs_value >&2
                exit 1
            fi
            CONFIG_FILE="${!i}"
            ;;
        -l|--lang)
            i=$((i+1))
            if [ $i -gt $# ]; then
                te cli.error.lang_needs_value >&2
                exit 1
            fi
            if ! i18n_set_lang "${!i}"; then
                te cli.error.unsupported_lang "${!i}" >&2
                exit 1
            fi
            ;;
        --lang=*)
            _langval="${arg#--lang=}"
            if [ -z "$_langval" ]; then
                te cli.error.lang_needs_value >&2
                exit 1
            fi
            if ! i18n_set_lang "$_langval"; then
                te cli.error.unsupported_lang "$_langval" >&2
                exit 1
            fi
            ;;
        --json)          JSON_MODE=true ;;
        -v|--verbose)    VERBOSE=true ;;
        --dry-run)       DRY_RUN=true ;;
        -h|--help)       show_help; exit 0 ;;
        --check-deps)    check_deps; exit $? ;;
        *)
            POSITIONAL+=("$arg")
            ;;
    esac
    i=$((i+1))
done
set -- "${POSITIONAL[@]}"

# 未显式指定 --lang 时，用最终配置路径重新解析（配置里的 language: 生效）
i18n_init

export CONFIG_FILE JSON_MODE VERBOSE DRY_RUN I18N_LANG

if [ $# -eq 0 ]; then
    show_help
    exit 1
fi

COMMAND="$1"; shift

case "$COMMAND" in
    list)       cmd_list "$@" ;;
    info)       cmd_info "$@" ;;
    ls)         cmd_ls "$@" ;;
    tree)       cmd_tree "$@" ;;
    mount)      cmd_mount "$@" ;;
    umount)     cmd_umount "$@" ;;
    create)     cmd_create "$@" ;;
    remove)     cmd_remove "$@" ;;
    log)        cmd_log "$@" ;;
    config)     echo "$CONFIG_FILE" ;;
    edit)       ${EDITOR:-nano} "$CONFIG_FILE" ;;
    check-deps) check_deps ;;
    help|--help|-h) show_help ;;
    *)
        te cli.error.unknown_command "$COMMAND" >&2
        show_help
        exit 1
        ;;
esac